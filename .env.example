PORT=8008
BASE_URL=http://localhost:8008

# Database (inside Docker use host "db" instead of "localhost")
DB_URL=postgresql://postgres:password@localhost:5432/uzchess
DEFAULT_DB_URL=postgresql://postgres:password@localhost:5432/postgres
TEST_DB_URL=postgresql://postgres:password@localhost:5432/uzchess_test

# Used by the postgres container in docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=uzchess

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# OTP lifetime and resend timeout, in seconds
OTP_EXPIRE=120
OTP_RESEND=60

# Pagination defaults
DEFAULT_PAGE=1
DEFAULT_SIZE=10
